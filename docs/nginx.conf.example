# 公司基本信息管理系统 - Nginx 生产配置示例
# 使用方式：按需修改 server_name / 证书 / 路径后放入 /etc/nginx/conf.d/ 并 reload

upstream company_info_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name example.com;

    # HTTP 强制跳转 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name example.com;

    ssl_certificate     /etc/nginx/ssl/example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 上传/请求体大小与超时
    client_max_body_size 10m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    # 前端静态资源（npm run build 产物）
    root /opt/company-info-system/frontend/dist;
    index index.html;

    # gzip
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1k;

    # API 反向代理（路径保持不变，后端前缀 /api/v1）
    location /api/ {
        proxy_pass http://company_info_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Swagger 文档默认不对外暴露；如需内网开放可改为 allow/deny
    location ~ ^/(swagger-ui|v3/api-docs) {
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://company_info_backend;
        proxy_set_header Host $host;
    }

    # SPA fallback：前端路由全部回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
